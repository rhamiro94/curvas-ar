# Copiá este archivo como .env y completá tus credenciales de la API de PPI.
# .env NO se sube a GitHub (está en .gitignore). En GitHub Actions van como Secrets.
PPI_PUBLIC_KEY=tu_key_publica
PPI_PRIVATE_KEY=tu_key_privada

